---
// Same category pages as /portafolio/[categoria]/, in English (same slugs).
import type { GetStaticPaths } from "astro";
import PortfolioView from "../../../views/PortfolioView.astro";
import { galleryFacets } from "../../../lib/gallery";
import type { CategoryGroup } from "../../../lib/gallery-shared";

export const getStaticPaths = (async () => {
  const { categoryGroups } = await galleryFacets();
  return categoryGroups
    .filter((group) => group.parent)
    .map((group) => ({ params: { category: group.slug }, props: { group } }));
}) satisfies GetStaticPaths;

const { group } = Astro.props as { group: CategoryGroup };
---

<PortfolioView locale="en" group={group} />
