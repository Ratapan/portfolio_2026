---
// Una sola 404 bilingüe: Vercel sirve esta página para cualquier ruta que no
// exista (dist/404.html), sin saber el idioma de la URL.
import Base from "../layouts/Base.astro";
import { ROUTES, t } from "../i18n";
---

<Base locale="es" route="home" title={t("es", "notFound.title")}>
  <div class="mx-auto max-w-xl space-y-10 px-4 py-20 text-center">
    <p class="font-serif text-7xl text-accent">404</p>
    <section class="space-y-2">
      <h1 class="text-2xl font-bold">{t("es", "notFound.title")}</h1>
      <p class="text-font2">{t("es", "notFound.text")}</p>
      <a href={ROUTES.home.es} class="btn mt-2">{t("es", "notFound.back")}</a>
    </section>
    <section class="space-y-2" lang="en">
      <h2 class="text-xl font-bold">{t("en", "notFound.title")}</h2>
      <p class="text-font2">{t("en", "notFound.text")}</p>
      <a href={ROUTES.home.en} class="btn mt-2">{t("en", "notFound.back")}</a>
    </section>
  </div>
</Base>
