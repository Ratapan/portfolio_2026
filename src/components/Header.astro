---
import { NAV, ROUTES, t, type Locale, type RouteName } from "../i18n";

interface Props {
  locale: Locale;
  current: RouteName;
}

const { locale, current } = Astro.props;
const items = NAV.filter((item) => item.ready);
---

<header class="border-b border-line/60">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4">
    <a
      href={ROUTES.home[locale]}
      class="font-serif text-2xl font-bold tracking-tight text-font1 hover:text-accent"
      aria-current={current === "home" ? "page" : undefined}
    >
      {t(locale, "common.brand")}
    </a>
    <nav aria-label={t(locale, "nav.menu")} class="-mx-1 overflow-x-auto">
      <ul class="flex items-center gap-1 text-sm whitespace-nowrap sm:gap-2">
        {
          items.map((item) => (
            <li>
              <a
                href={ROUTES[item.route][locale]}
                class:list={[item.accent ? "btn btn-accent py-1.5" : "link inline-block px-2 py-1.5"]}
                aria-current={current === item.route ? "page" : undefined}
              >
                {t(locale, `nav.${item.route}`)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
