---
// Sobre mí: el About 2025 portado (textos, experiencia, herramientas y redes)
// más la sección nueva "Mi equipo", calculada del EXIF en el build.
import Base from "../layouts/Base.astro";
import DetailsExp from "../components/about/DetailsExp.astro";
import ToolsGrid from "../components/about/ToolsGrid.astro";
import GearStats from "../components/about/GearStats.astro";
import { raw, t, type Locale } from "../i18n";
import { getPhotos } from "../lib/photos";
import { gearStats } from "../lib/gear";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

interface Experience {
  company: string;
  position: string;
  dates: string;
  content: string;
  skillsTitle: string;
  skills: string;
}
const experience = (raw(locale, "about.xp") as Experience[] | undefined) ?? [];
const stats = gearStats(await getPhotos(), locale);

// AVIF: Transformations no lo acepta como origen, así que va tal cual.
const portrait = { src: "https://assets.javiersabando.lat/blog/images/yo.avif", width: 1440, height: 1080 };
const portraitSizes = "(min-width: 768px) 560px, 100vw";

const iconBase = "https://assets.javiersabando.lat/coffeIcons";
const socials = [
  { name: "LinkedIn", href: "https://www.linkedin.com/in/javier-sabando/", icon: "linkedin.svg" },
  { name: "GitHub", href: "https://github.com/Ratapan", icon: "github.svg" },
  { name: "Instagram", href: "https://www.instagram.com/ratapics", icon: "ig.svg" },
  { name: "YouTube", href: "https://www.youtube.com/@rtpdev", icon: "youtube.svg" },
];
---

<Base
  locale={locale}
  route="about"
  title={t(locale, "meta.aboutTitle")}
  description={t(locale, "meta.aboutDescription")}
  image={portrait.src}
  preloadImage={{ src: portrait.src }}
>
  <div class="mx-auto max-w-6xl space-y-14 px-4 py-8">
    <header class="text-center">
      <h1 class="mb-2 text-3xl font-bold sm:text-4xl">{t(locale, "about.title").trim()}</h1>
      <p class="text-lg text-font2">{t(locale, "about.subtitle")}</p>
    </header>

    <section class="grid items-center gap-8 overflow-hidden rounded-2xl bg-surface md:grid-cols-2">
      <img
        src={portrait.src}
        width={portrait.width}
        height={portrait.height}
        sizes={portraitSizes}
        alt="Javier Sabando"
        fetchpriority="high"
        class="h-auto w-full object-cover"
      />
      <p class="px-5 pb-6 leading-relaxed md:py-6 md:pr-8 md:pl-0 lg:text-lg">
        {t(locale, "about.content.aboutMe")}
      </p>
    </section>

    <section>
      <h2 class="mb-6 text-center text-2xl font-bold">{t(locale, "about.sections.searchMe")}</h2>
      <ul class="flex items-center justify-center gap-6">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="block transition-transform hover:scale-125"
                aria-label={s.name}
                title={s.name}
              >
                <img src={`${iconBase}/${s.icon}`} alt="" width="32" height="32" class="size-8 object-contain" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      stats.total > 0 && (
        <section>
          <h2 class="mb-2 text-center text-2xl font-bold">{t(locale, "gear.title")}</h2>
          <GearStats stats={stats} locale={locale} />
        </section>
      )
    }

    <div class="grid gap-10 lg:grid-cols-2">
      <section>
        <h2 class="mb-4 text-2xl font-bold">{t(locale, "about.sections.xpTitle")}</h2>
        <div class="space-y-1">
          {experience.map((xp, i) => <DetailsExp name="xp" open={i === 0} {...xp} />)}
        </div>
      </section>
      <section>
        <h2 class="mb-4 text-2xl font-bold">{t(locale, "about.sections.toolsTitle")}</h2>
        <ToolsGrid locale={locale} />
      </section>
    </div>
  </div>
</Base>
