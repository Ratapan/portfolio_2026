{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/about", "destination": "/sobre-mi/", "permanent": true },
    { "source": "/about/", "destination": "/sobre-mi/", "permanent": true },
    { "source": "/blog", "destination": "/articulos/", "permanent": true },
    { "source": "/blog/", "destination": "/articulos/", "permanent": true },
    { "source": "/blog/:slug", "destination": "/articulos/:slug/", "permanent": true },
    { "source": "/blog/:slug/", "destination": "/articulos/:slug/", "permanent": true },
    { "source": "/repo", "destination": "/proyectos/", "permanent": true },
    { "source": "/repo/", "destination": "/proyectos/", "permanent": true },
    { "source": "/repo/:slug", "destination": "/proyectos/:slug/", "permanent": true },
    { "source": "/repo/:slug/", "destination": "/proyectos/:slug/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
