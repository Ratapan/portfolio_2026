# URI de Mongo con el usuario de SOLO LECTURA del build (portfolio_build).
# Solo se usa al compilar: el sitio publicado no habla con Mongo.
MONGODB_URI=mongodb://portfolio_build:<password>@<host>:<puerto>/rtp_blog?authSource=rtp_blog

# --- Encargos (función api/encargos.ts; en Vercel van en Environment Variables) ---
# Clave PÚBLICA del widget de Turnstile (va en el HTML). Sin ella, el build usa
# la clave de pruebas de Cloudflare, que solo sirve en local.
PUBLIC_TURNSTILE_SITE_KEY=
# Secret del widget de Turnstile (solo servidor).
TURNSTILE_SECRET_KEY=
# API key de Resend con permiso solo de envío (solo servidor).
RESEND_API_KEY=
# Remitente en un dominio verificado en Resend.
ENCARGOS_FROM=Rapics <web@javiersabando.lat>
# Destino del correo (Email Routing lo reenvía a tu correo personal).
ENCARGOS_TO=encargos@javiersabando.lat

# --- Analítica ---
# Token de Cloudflare Web Analytics (público). Sin él, no se carga el script.
PUBLIC_CF_BEACON_TOKEN=
