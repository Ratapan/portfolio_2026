---
// Listado de colecciones curadas (bilingüe: títulos e intros en es/en).
import Base from "../layouts/Base.astro";
import CollectionCard from "../components/CollectionCard.astro";
import { t, type Locale } from "../i18n";
import { getCuratedCollections } from "../lib/collections";
import { cfImage } from "../lib/img";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const collections = await getCuratedCollections();
---

<Base
  locale={locale}
  route="collections"
  title={t(locale, "collections.listTitle")}
  description={t(locale, "collections.metaDescription")}
  image={collections[0] ? cfImage(collections[0].cover.url, 1600) : undefined}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <header class="mb-8 space-y-2 text-center">
      <h1 class="text-3xl font-bold md:text-4xl">{t(locale, "collections.listTitle")}</h1>
      <p class="text-font2">{t(locale, "collections.listSubtitle")}</p>
    </header>

    {
      collections.length === 0 ? (
        <p class="py-20 text-center text-font2">{t(locale, "collections.empty")}</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2">
          {collections.map((c, i) => (
            <CollectionCard collection={c} locale={locale} priority={i < 2} />
          ))}
        </div>
      )
    }
  </div>
</Base>
