// Worker "portfolio": por ahora solo sirve el sitio estático de dist/.
// En la fase 6 se suma el adapter de Cloudflare para POST /api/encargos.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
