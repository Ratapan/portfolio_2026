---
// Página de un artículo o proyecto (solo en español).
import Base from "../layouts/Base.astro";
import ArticleBody from "../components/article/ArticleBody.astro";
import { ROUTES, t } from "../i18n";
import { formatDate, type PostData } from "../lib/posts";
import { cfImage, srcset } from "../lib/img";

interface Props {
  post: PostData;
  kind: "articles" | "projects";
}

const { post, kind } = Astro.props;
const locale = "es" as const;
const cover = post.cover;
// Una portada vertical queda limitada por el alto (80vh), no por el ancho.
const ratio = cover.w && cover.h ? cover.w / cover.h : 1.5;
const coverSizes = `min(1024px, calc(100vw - 32px), calc(80vh * ${ratio.toFixed(3)}))`;
const ns = kind === "articles" ? "article" : "projects";
---

<Base
  locale={locale}
  route={kind}
  path={`${post.slug}/`}
  single
  title={post.title}
  description={post.description || post.excerpt}
  image={cfImage(cover.url, 1600)}
  preloadImage={{ src: cfImage(cover.url, 960), srcset: srcset(cover.url, cover.w), sizes: coverSizes }}
  article={{ publishedAt: post.publishedAt, updatedAt: post.updatedAt }}
>
  <article class="px-4 py-8">
    <header class="mx-auto mb-8 max-w-[680px] space-y-3 text-center">
      <p class="text-xs text-font2">
        <a href={ROUTES[kind].es} class="link">← {t(locale, `${ns}.back`)}</a>
      </p>
      <h1 class="text-3xl leading-tight font-bold md:text-5xl">{post.title}</h1>
      <p class="text-sm text-font2">
        <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt, locale)}</time>
        {post.type === "blog" && <span> · {t(locale, "article.minRead", { n: post.readingMinutes })}</span>}
      </p>
      {post.excerpt && <p class="text-lg leading-relaxed text-font2">{post.excerpt}</p>}
      {
        (post.githubUrl || post.demoUrl) && (
          <p class="flex justify-center gap-3 pt-2">
            {post.githubUrl && (
              <a href={post.githubUrl} class="btn" target="_blank" rel="noopener noreferrer">
                {t(locale, "projects.github")}
              </a>
            )}
            {post.demoUrl && (
              <a href={post.demoUrl} class="btn btn-accent" target="_blank" rel="noopener noreferrer">
                {t(locale, "projects.demo")}
              </a>
            )}
          </p>
        )
      }
    </header>

    <figure class="mx-auto mb-10 max-w-5xl">
      <img
        src={cfImage(cover.url, 960)}
        srcset={srcset(cover.url, cover.w)}
        sizes={coverSizes}
        width={cover.w}
        height={cover.h}
        alt=""
        fetchpriority="high"
        class:list={[
          "mx-auto block rounded-xl",
          cover.w ? "h-auto max-h-[80vh] w-auto max-w-full" : "aspect-[3/2] w-full object-cover",
        ]}
        style={cover.c ? `background-color:${cover.c}` : undefined}
      />
    </figure>

    <ArticleBody blocks={post.blocks} locale={locale} />

    {
      (post.technologies.length > 0 || post.tags.length > 0) && (
        <footer class="mx-auto mt-12 max-w-[680px] space-y-3 border-t border-line pt-6 text-sm">
          {post.technologies.length > 0 && (
            <div>
              <h2 class="mb-2 font-sans text-xs tracking-wide text-font2 uppercase">{t(locale, "projects.technologies")}</h2>
              <ul class="flex flex-wrap gap-1.5">
                {post.technologies.map((tech) => (
                  <li class="rounded-full border border-line px-2.5 py-0.5">{tech}</li>
                ))}
              </ul>
            </div>
          )}
          {post.tags.length > 0 && (
            <div>
              <h2 class="mb-2 font-sans text-xs tracking-wide text-font2 uppercase">{t(locale, "article.tags")}</h2>
              <ul class="flex flex-wrap gap-1.5 text-font2">
                {post.tags.map((tag) => (
                  <li class="rounded-full bg-surface px-2.5 py-0.5">#{tag}</li>
                ))}
              </ul>
            </div>
          )}
        </footer>
      )
    }
  </article>
</Base>
