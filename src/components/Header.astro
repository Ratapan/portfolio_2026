---
import { NAV, ROUTES, t, type Locale, type RouteName } from "../i18n";
import { getProjects } from "../lib/posts";
import { getCuratedCollections } from "../lib/collections";

interface Props {
  locale: Locale;
  current: RouteName;
}

const { locale, current } = Astro.props;
// Sin proyectos o colecciones publicadas, esa sección no aparece en el menú
// (la página existe igual, con su estado vacío).
const empty = new Set<RouteName>();
if (!(await getProjects()).length) empty.add("projects");
if (!(await getCuratedCollections()).length) empty.add("collections");
const visible = NAV.filter((item) => item.ready && !empty.has(item.route));
const links = visible.filter((item) => !item.accent);
// El botón destacado (Encargos) va aparte: en móvil queda junto al logo y el
// resto del menú baja a una segunda fila, así nunca queda fuera de la pantalla.
const cta = visible.find((item) => item.accent);
---

<header class="border-b border-line/60">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-4">
    <a
      href={ROUTES.home[locale]}
      class="mr-auto font-serif text-2xl font-bold tracking-tight text-font1 hover:text-accent"
      aria-current={current === "home" ? "page" : undefined}
    >
      {t(locale, "common.brand")}
    </a>
    <nav aria-label={t(locale, "nav.menu")} class="order-last -mx-1 w-full overflow-x-auto sm:order-none sm:w-auto">
      <ul class="flex items-center gap-1 text-sm whitespace-nowrap sm:gap-2">
        {
          links.map((item) => (
            <li>
              <a
                href={ROUTES[item.route][locale]}
                class="link inline-block px-2 py-1.5"
                aria-current={current === item.route ? "page" : undefined}
              >
                {t(locale, `nav.${item.route}`)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      cta && (
        <a
          href={ROUTES[cta.route][locale]}
          class="btn btn-accent py-1.5 text-sm"
          aria-current={current === cta.route ? "page" : undefined}
        >
          {t(locale, `nav.${cta.route}`)}
        </a>
      )
    }
  </div>
</header>
